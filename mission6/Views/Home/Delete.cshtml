@{
}
@model Movie

<h2>Confirm Deletion</h2>
<h3>@Model.Title</h3>

<form method="post">
	@* include hidden movie id so program knows which movie to delete *@
	<input type="hidden" asp-for="MovieId" />
	<button type="submit" class="btn btn-danger">Delete</button>
	<a asp-action="ListMovies" class="btn btn-info">Cancel</a>
</form>
